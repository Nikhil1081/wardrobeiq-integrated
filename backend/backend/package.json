{
  "name": "wardrobeiq-backend",
  "version": "1.0.0",
  "description": "WardrobeIQ - AI Wardrobe Gap & Personal Styling Recommendation Agent Backend",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "generate-seed": "tsx scripts/generate-seed-data.ts",
    "seed": "tsx scripts/seed-mongodb.ts"
  },
  "dependencies": {
    "@langchain/core": "^0.3.40",
    "@langchain/langgraph": "^0.2.54",
    "@langchain/openai": "^0.4.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "mongodb": "^6.14.0",
    "wardrobeiq-integrated": "file:../..",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "mongodb-memory-server": "^10.1.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "wardrobeiq",
    "fashion",
    "recommendation-engine",
    "langgraph",
    "mongodb"
  ],
  "author": "WardrobeIQ Team",
  "license": "ISC"
}
